{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/purge",
      "schedule": "0 3 * * *"
    }
  ]
}
