# Copy to .env.local for development. Never commit real values.
# Production values live in Vercel Project Settings > Environment Variables.
# Validation lives in src/lib/security/env-schema.ts.

# --- Public (shipped to the browser; safe values only) ---------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cloudflare Turnstile site key (public). Leave blank to disable the bot check locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (required now) --------------------------------------------
# Bypasses RLS. Only for interview-token endpoints and webhooks. Never in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Server only (optional until the phase noted) --------------------------
# Phase 2: Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 1 in production: refuses to start without Upstash (otherwise rate limits are per serverless instance)
REQUIRE_DISTRIBUTED_RATE_LIMIT=
# Phase 2/3: Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Phase 3: Claude API and Cloudflare Turnstile
ANTHROPIC_API_KEY=
# Optional: model for the interviewer (default claude-haiku-4-5-20251001)
INTERVIEWER_MODEL=
# Optional: model for case study generation (default claude-sonnet-5-5)
GENERATOR_MODEL=
TURNSTILE_SECRET_KEY=
# "1" if a trusted proxy overwrites X-Forwarded-For. Automatic on Vercel; leave blank there.
# Without it, production ignores forwarded IP headers (all clients share one rate-limit bucket).
TRUST_PROXY_HEADERS=
# Abuse and spend limits (all optional; defaults in docs/limits.md)
AI_MESSAGES_FREE=
AI_MESSAGES_PRO=
AI_MESSAGES_TEAM=
AI_DAILY_TOKEN_LIMIT=
INTERVIEW_STARTS_PER_IP_HOUR=
# Where the spend circuit-breaker alert is emailed
ALERT_EMAIL=
# Phase 9: web push. Generate once with: npx web-push generate-vapid-keys
# (the private key is server only)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Phase 6: the domain public case study pages are served from, one subdomain per workspace
# (acme.<this>/<slug>). Needs a wildcard DNS record. Local: localhost:3000. Unset: public pages are off.
PUBLIC_SITES_DOMAIN=
# Phase 11: where vulnerability reports go (mailto:security@yourdomain or an https URL); published as /.well-known/security.txt
SECURITY_CONTACT=
# Phase 6: comma-separated emails of the platform operators (takedown reports, /app/admin/takedowns)
PLATFORM_ADMIN_EMAILS=
# Phase 6: random 32+ chars (openssl rand -hex 32)
IP_HASH_SECRET=
# Phase 7: random 32+ chars (openssl rand -hex 32)
CRON_SECRET=
# Optional: seconds a sign-in counts as "recent" for sensitive actions (default 600)
REAUTH_MAX_AGE_SECONDS=
# Phase 8: Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Stripe Price id the Pro plan is sold under (price_...)
STRIPE_PRICE_PRO=
